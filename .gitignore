# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# URL del servidor cacheada por la skill project-manager-sk — no es secreta,
# pero es específica de cada entorno (local, staging, producción).
.claude/skills/project-manager-sk/.cached-base-url

# Export puntual de usuarios (con password hasheado) para sembrar la base de
# producción en la migración a Hostinger — nunca commitear.
scripts/production-users-seed.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local de desarrollo (SQLite) — contiene hashes de contraseña
*.db
*.db-journal

# archivos subidos por usuarios (insumos/evidencias de tareas)
/public/uploads/*
!/public/uploads/.gitkeep

# Sesión de WhatsApp (Baileys) — credenciales del dispositivo vinculado
/.baileys-auth
projectmanagersk-deploy.zip

# ---------------------------------------------------------------------------
# Artefactos de agentes de IA y herramientas (CodeGPT, Claude, editores).
# No forman parte del producto: son cache, config local o carpetas temporales.
# ---------------------------------------------------------------------------

# Configuracion local de agentes
.codegpt/
.claude/settings.local.json
.claude/*.local.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.aider*
.continue/
.cursor/
.windsurf/

# Caches de indexado / mapas de proyecto generados por las skills
.lens-sk-cache/
.impeccable/config.local.json
# Carpetas temporales de trabajo de agentes
_tmp_editor/
_tmp*/

# Arbol de HOME relativo (lo genera correr herramientas con HOME=$PWD)
/home/

# Backups y temporales de editores
*.orig
*.rej
*.bak
*~
*.swp
._*
