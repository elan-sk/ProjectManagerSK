# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local de desarrollo (SQLite) — contiene hashes de contraseña
*.db
*.db-journal

# archivos subidos por usuarios (insumos/evidencias de tareas)
/public/uploads/*
!/public/uploads/.gitkeep

# Lens-SK (toolbar de depuración visual, solo desarrollo)
/dev-tools
/public/dev-tools
/.lens-sk-cache

# Sesión de WhatsApp (Baileys) — credenciales del dispositivo vinculado
/.baileys-auth
