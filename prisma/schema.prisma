generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL — el que ya viene incluido en el plan de hosting de Hostinger
  // (antes SQLite en desarrollo). DATABASE_URL vive en prisma.config.ts
  // (Prisma 7), no acá; dev y producción usan el mismo proveedor de ahora en
  // más (Prisma no admite un provider distinto por entorno en un mismo
  // schema).
  provider = "mysql"
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  // Reemplaza al borrado real de un proyecto — un delete en cascada sobre un
  // proyecto con historial real (miles de notificaciones/tareas/revisiones)
  // bloquea las tablas el tiempo suficiente para colgar toda la app en un
  // hosting compartido con recursos limitados. Archivar es una sola fila
  // (instantáneo) y deja el historial intacto.
  ARCHIVED
}

// Punto 2 (unificación): CHECKLIST y MEETING dejaron de ser tipos — ahora
// cualquier tarea puede tener checklist y/o un link de reunión. MILESTONE se
// presenta como "Entregable" (evidencia obligatoria) y QA como "Revisión"
// (nombre interno del enum sin tocar para no migrar datos existentes).
enum TaskType {
  SIMPLE
  MILESTONE
  QA
  ADJUSTMENT
  // Lista de características/funcionalidades entregadas, descritas con
  // evidencia opcional, que el CLIENTE (sin cuenta, por el link compartido)
  // va aceptando o devolviendo una por una — mismo motor de rondas que QA
  // (ReviewRound/ReviewCheck), pero quien califica es externo, no un
  // TaskReviewer interno (ver ReviewCheck.externalReviewerName más abajo).
  ACCEPTANCE
}

// RETURNED ("Devuelta", punto 2.6): una ronda de Revisión cerró con al menos
// un check "Con errores" — la tarea vuelve al responsable hasta que reenvíe
// y la ronda siguiente quede aprobada.
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  RETURNED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AttachmentKind {
  INSUMO
  RESULTADO
}

enum NotificationType {
  ASSIGNED
  DEADLINE_APPROACHING
  OVERDUE
  BLOCKED
  DELAY_CAUSED
  RETURNED
  // Ronda nueva enviada a revisión — avisa a los revisores de la tarea que
  // hay algo esperando (antes no existía ningún aviso para esto).
  REVIEW_REQUESTED
  // Tarea NOT_STARTED cuya plannedStart ya pasó (debería estar en curso):
  // LATE_START mientras es reciente (≤2 días hábiles, alerta suave por DM),
  // LATE_START_CRITICAL al superar ese umbral (grave, va al grupo).
  LATE_START
  LATE_START_CRITICAL
  // Alguien comentó o subió un archivo desde un link compartido (punto 16).
  SHARE_ACTIVITY
}

enum ShareTargetType {
  PROJECT
  TASK
}

enum ReviewOutcome {
  APPROVED
  RETURNED
}

enum CheckResult {
  APPROVED // Aprobada
  FLAGGED // Con hallazgos
  FAILED // Con errores
  NOT_APPLICABLE // Punto 14: no cuenta para aprobar ni para devolver la ronda
}

// FINISH_TO_START (la de siempre): la sucesora no puede empezar antes de
// que termine la predecesora. START_TO_START ("en paralelo" del Excel de
// Racafé, ej. QA continua junto a su Sprint): ambas deben empezar el mismo
// día — si la predecesora se mueve, la sucesora se mueve con ella.
enum DependencyType {
  FINISH_TO_START
  START_TO_START
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  // Identificador principal para entrar — obligatorio y único.
  username             String    @unique
  // Opcional a partir de ahora (username es el principal). Único cuando está
  // definido; varios usuarios pueden tener null a la vez.
  email                String?   @unique
  passwordHash         String
  role                 Role      @default(MEMBER)
  // Reemplaza al borrado real de un usuario — varias tablas (PM de proyecto,
  // autor de revisión, etc.) exigen que el usuario exista para no perder de
  // quién es un dato histórico, así que "eliminar" pasa a ser desactivar: no
  // puede loguearse ni se lo puede asignar a nada nuevo, pero su historial
  // queda intacto.
  active               Boolean   @default(true)
  avatarUrl            String?
  // Con código de país (ej. 57...), sin +. Usado para mencionar al usuario en las alertas de WhatsApp.
  phone                String?
  // null = el bot todavía no le mandó ningún WhatsApp directo a esta persona.
  // Se completa al primer envío (ver sendRawMessage en whatsapp.ts): ese
  // primer mensaje va con la presentación del bot + foto de perfil; de ahí
  // en más, solo ícono 🤖 + nombre, sin foto.
  whatsappIntroducedAt DateTime?
  // Último día (calendario Bogotá) en que se le mandó el resumen diario de
  // WhatsApp. La clave conserva además la hora configurada para permitir un
  // nuevo envío el mismo día si un administrador cambia ese horario.
  lastDigestSentAt    DateTime?
  lastDigestScheduleKey String?
  createdAt            DateTime  @default(now())

  // Recuperar contraseña por WhatsApp: se guarda el HASH del token (nunca el
  // token en texto plano) para que una lectura de la base no alcance para
  // usarlo — de un solo uso y con vencimiento corto (ver forgotActions.ts).
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  // Sesión de la API pública (skills) vía login con usuario/contraseña —
  // igual que resetTokenHash, se guarda el HASH, nunca el token en texto
  // plano. De vida corta y de una sola sesión activa a la vez: pedir un
  // login nuevo revoca cualquier sesión anterior de ese usuario.
  apiSessionTokenHash String?   @unique
  apiSessionExpiresAt DateTime?

  pmOfProjects          Project[]                 @relation("ProjectPM")
  assignments           TaskAssignee[]
  attachments           Attachment[]
  projectAttachments    ProjectAttachment[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  googleCalendarConn    GoogleCalendarConnection?
  shareLinksCreated     ShareLink[]
  adjustmentAttachments AdjustmentAttachment[]
  reviewerOf            TaskReviewer[]            @relation("TaskReviewerUser")
  reviewRoundsSubmitted ReviewRound[]             @relation("ReviewRoundSubmitter")
  reviewChecksReviewed  ReviewCheck[]             @relation("ReviewCheckReviewer")
  reviewMessages        ReviewMessage[]
  botMessages           BotMessage[]
  internalMessages      InternalMessage[]
  internalMessageReads  InternalMessageRead[]
}

// Conexión OAuth de Google Calendar por usuario (punto 14: sincronizar
// cronograma/alarmas). Se autoriza una vez vía /api/google-calendar/connect;
// el refreshToken permite renovar el accessToken sin pedir permiso de nuevo.
model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
}

// Suscripción Web Push del navegador (punto 14: alarmas activas sin abrir
// la app). Un usuario puede tener varias si instala la PWA en más de un
// dispositivo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Los endpoints reales de push (FCM/Mozilla/Apple) pueden superar los 191
  // caracteres por defecto de MySQL — @unique exige un largo acotado (MySQL
  // no indexa TEXT sin prefijo), así que se declara explícito en vez de
  // arriesgar un insert roto.
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Project {
  id            String        @id @default(cuid())
  name          String
  clientName    String?
  countryCode   String        @default("CO")
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime
  // Deadline comprometido del proyecto (no se deriva del cronograma de
  // tareas) — opcional porque los proyectos existentes no tienen uno.
  targetEndDate DateTime?
  repoUrl       String?
  pmId          String
  pm            User          @relation("ProjectPM", fields: [pmId], references: [id])
  createdAt     DateTime      @default(now())

  // Pestaña "Definición" (gestión de proyecto, vocabulario alineado con las
  // Fases 1-2 de la skill /dev-project-definer — Problema/Requerimientos —
  // para poder transcribir directo lo que salga de esa skill).
  description String? @db.Text // HTML del editor WYSIWYG, igual que Task.description
  color       String? // hex; identidad visual rápida en resúmenes/tarjetas
  iconUrl     String? // logo/ícono subido; si no hay, se usa color + inicial

  // Grupo de WhatsApp propio para las alertas graves de este proyecto. Si es
  // null, se usa AppSetting.whatsappGroupJid (el grupo por defecto).
  whatsappGroupJid String?

  phases        Phase[]
  tasks         Task[]
  objectives    Objective[]
  requirements  Requirement[]
  links         ProjectLink[]
  attachments   ProjectAttachment[]
  shareLinks    ShareLink[]
  tags          Tag[]
  // Punto 4 (link compartido): comentarios generales de la pestaña
  // Definición — a diferencia de ShareComment.taskId, estos no cuelgan de
  // ninguna tarea puntual.
  shareComments ShareComment[]
  notifications Notification[]
  internalMessages InternalMessage[]
}

// Enlaces/archivos importantes del proyecto (punto 3.2) — se prioriza el
// link (Drive, Figma, repo, etc.) sobre subir el archivo, para no llenar la
// app de contenido que ya vive en otro lado.
model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())
}

// Archivo subido directamente (a diferencia de ProjectLink, que apunta a
// contenido externo) — mismo par fileUrl/fileName/mimeType que Attachment,
// pero a nivel de proyecto en vez de tarea.
model ProjectAttachment {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl              String
  fileName             String
  mimeType             String
  // Nulo cuando lo sube un visitante externo por el link compartido (punto
  // 15) — no tiene cuenta en la app, así que se identifica con su nombre en
  // vez de un uploadedById.
  uploadedById         String?
  uploadedBy           User?    @relation(fields: [uploadedById], references: [id])
  externalUploaderName String?
  externalUploaderRole String?
  uploadedAt           DateTime @default(now())
}

model Phase {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int

  tasks        Task[]
  requirements Requirement[] @relation("PhaseRequirements")
}

// "Objetivo" (Fase 1 de /dev-project-definer: el problema/meta que el
// proyecto busca resolver) — su % de avance se calcula en cascada como el
// promedio del % de sus Requerimientos vinculados (ver lib/cascadeProgress.ts).
model Objective {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())

  requirements Requirement[] @relation("RequirementObjectives")
}

// "Requerimiento" (Fase 2 de /dev-project-definer) — se cumple a través de
// una o varias Fases del cronograma; su % de avance es el promedio del %
// completado de esas fases (mismo % que ya se ve por fase en el Gantt).
model Requirement {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())

  objectives Objective[] @relation("RequirementObjectives")
  phases     Phase[]     @relation("PhaseRequirements")
}

model Task {
  id                    String     @id @default(cuid())
  projectId             String
  project               Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId               String
  phase                 Phase      @relation(fields: [phaseId], references: [id])
  type                  TaskType   @default(SIMPLE)
  title                 String
  description           String?    @db.Text
  status                TaskStatus @default(NOT_STARTED)
  riskLevel             RiskLevel  @default(LOW)
  // Punto 2.4: cualquier tarea puede tener un link de reunión — el día es
  // la propia plannedStart/plannedEnd de la tarea, y "vincular con Google"
  // ya lo cubre el botón de Google Calendar existente por tarea. meetingAt
  // guarda la hora exacta (independiente del rango de días del cronograma)
  // para poder calcular el recordatorio 30 min antes por WhatsApp;
  // meetingReminderSentAt evita mandarlo dos veces.
  meetingUrl            String?
  meetingAt             DateTime?
  meetingReminderSentAt DateTime?

  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?

  createdAt DateTime @default(now())
  // Punto 12 (tiempo real sin pisadas): marca de tiempo de la última
  // modificación, usada como bloqueo optimista en las acciones de mayor
  // riesgo de choque (arrastrar/redimensionar en Gantt, arrastrar en
  // Kanban) — si alguien más ya modificó la tarea desde que el cliente la
  // cargó, la acción se rechaza en vez de pisar el cambio ajeno.
  updatedAt DateTime @updatedAt

  assignees       TaskAssignee[]
  steps           TaskStep[]
  attachments     Attachment[]
  notifications   Notification[]
  adjustmentItems AdjustmentItem[]
  reviewers       TaskReviewer[]
  reviewRounds    ReviewRound[]
  shareComments   ShareComment[]
  taskTags        TaskTag[]

  // Punto 10: plantilla elegida desde la creación de la tarea tipo Prueba —
  // se copia sola como checks apenas nace la ronda 1 (ver submitReviewRound),
  // sin que el revisor tenga que aplicarla a mano. SetNull: borrar la
  // plantilla original no debe romper tareas que ya la tenían elegida.
  defaultTestTemplateId String?
  defaultTestTemplate   TestTemplate? @relation(fields: [defaultTestTemplateId], references: [id], onDelete: SetNull)

  // Dependencias: esta tarea depende de (predecesoras) / bloquea a (sucesoras)
  dependsOn TaskDependency[] @relation("SuccessorTask")
  blocks    TaskDependency[] @relation("PredecessorTask")

  shareLinks ShareLink[]
  internalMessages InternalMessage[]
}

// Conversación estrictamente interna: nunca se consulta desde /share ni se
// serializa en enlaces públicos. Un mensaje pertenece al proyecto o a una
// tarea concreta del mismo proyecto.
model InternalMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  reads     InternalMessageRead[]

  @@index([projectId, taskId, createdAt])
}

model InternalMessageRead {
  messageId String
  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId, readAt])
}

// Punto 2.6: segundo grupo de personas de una tarea tipo Revisión — quienes
// revisan, distinto de TaskAssignee (quienes ejecutan).
model TaskReviewer {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("TaskReviewerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

// Join table explícita: permite compartir/reasignar responsabilidad de una
// misma tarea entre varios usuarios (punto 5 del manuscrito).
model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null = este asignado todavía no entró al detalle de la tarea. Se completa
  // la primera vez que abre /projects/[id]/tasks/[taskId] (ver page.tsx) — es
  // por (tarea, usuario) porque una tarea puede tener varios asignados.
  viewedAt DateTime?

  @@id([taskId, userId])
}

model TaskDependency {
  id            String         @id @default(cuid())
  predecessorId String
  predecessor   Task           @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     Task           @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)
  type          DependencyType @default(FINISH_TO_START)

  @@unique([predecessorId, successorId])
}

// Pasos de una tarea tipo CHECKLIST (también cubre los ítems de una tarea QA).
model TaskStep {
  id          String  @id @default(cuid())
  taskId      String
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  description String  @db.Text
  done        Boolean @default(false)
  order       Int
}

// Insumos (archivos/imágenes de entrada) y Resultados (evidencia) de una
// tarea. Cubre también el patrón antes/después de Ajustes.xlsx.
model Attachment {
  id                   String         @id @default(cuid())
  taskId               String
  task                 Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind                 AttachmentKind
  fileUrl              String
  fileName             String
  mimeType             String
  // Nulo cuando lo sube un visitante externo por el link compartido de la
  // tarea (punto 16, solo INSUMO) — se identifica con su nombre en vez de
  // un uploadedById.
  uploadedById         String?
  uploadedBy           User?          @relation(fields: [uploadedById], references: [id])
  externalUploaderName String?
  externalUploaderRole String?
  uploadedAt           DateTime       @default(now())
}

// Punto 2.5: un cambio solicitado dentro de una tarea tipo ADJUSTMENT. Se
// considera "respondido" cuando tiene al menos un adjunto AFTER o una nota
// (no aplica un checkbox manual — el estado se deriva de la evidencia).
model AdjustmentItem {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  description String   @db.Text
  note        String?  @db.Text
  // Confirmación del cliente desde el link compartido. Es trazabilidad de
  // entrega, no una compuerta: el equipo puede completar el ajuste aunque el
  // cliente todavía no haya respondido.
  clientApproval Boolean?
  clientApprovalAt DateTime?
  clientApprovalBy String?
  order       Int
  createdAt   DateTime @default(now())

  attachments   AdjustmentAttachment[]
  shareComments ShareComment[]
}

// Punto 16: hilo de comentarios de la vista compartida de una tarea —
// público para cualquiera con el link (confirmado con el usuario), sin
// cuenta: se identifica con nombre (y cargo opcional) en vez de un userId.
// adjustmentItemId ancla el comentario a un cambio puntual de una tarea tipo
// Ajuste; queda null para un comentario general de la tarea.
// Punto 4: taskId pasó a ser opcional y se sumó projectId — un comentario
// cuelga de UNA tarea O de un proyecto (pestaña Definición del link
// compartido), nunca de los dos ni de ninguno (lo valida shareActions.ts,
// no hay constraint de DB para esto). parentId permite responder un
// comentario ya existente (un solo nivel de anidamiento, no hilos recursivos).
model ShareComment {
  id               String          @id @default(cuid())
  taskId           String?
  task             Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adjustmentItemId String?
  adjustmentItem   AdjustmentItem? @relation(fields: [adjustmentItemId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           ShareComment?   @relation("ShareCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          ShareComment[]  @relation("ShareCommentReplies")
  authorName       String
  authorRole       String?
  body             String          @db.Text
  createdAt        DateTime        @default(now())
}

enum AdjustmentAttachmentKind {
  BEFORE
  AFTER
}

model AdjustmentAttachment {
  id               String                   @id @default(cuid())
  adjustmentItemId String
  adjustmentItem   AdjustmentItem           @relation(fields: [adjustmentItemId], references: [id], onDelete: Cascade)
  kind             AdjustmentAttachmentKind
  fileUrl          String
  fileName         String
  mimeType         String
  uploadedById     String
  uploadedBy       User                     @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime                 @default(now())
}

// Caché local de festivos (fuente: Nager.Date). Se resuelve solo, el
// usuario nunca los carga a mano.
model Holiday {
  id          String   @id @default(cuid())
  countryCode String
  date        DateTime
  name        String
  year        Int

  @@unique([countryCode, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Punto 4: para avisos sin tarea puntual (ej. comentario en la pestaña
  // Definición de un proyecto) — sin esto, la campana no tenía cómo armar
  // el link (antes lo derivaba solo de task.projectId, que acá es null).
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

// Enlace de acceso público de solo lectura para clientes externos sin
// cuenta (punto 1) — el token ES la autenticación (nadie sin el link exacto
// entra), igual que "cualquiera con el link" de Figma/Drive. Generar uno
// nuevo para el mismo proyecto/tarea revoca automáticamente los anteriores
// (revokedAt) — nunca hay dos activos a la vez para el mismo destino.
model ShareLink {
  id          String          @id @default(cuid())
  token       String          @unique
  targetType  ShareTargetType
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  revokedAt   DateTime?
}

// Configuración global de la app — una sola fila fija (id="app"). Hoy solo
// guarda el país usado para calcular festivos/días hábiles en TODOS los
// proyectos (antes vivía hardcodeado como PROJECT_COUNTRY_CODE en
// projects/actions.ts — la app siempre opera con un único país a la vez, así
// que se centraliza acá en vez de repetirlo por proyecto).
model AppSetting {
  id          String @id
  countryCode String @default("CO")

  // Escalamiento de alertas por WhatsApp: grupo al que caen las alertas
  // graves de proyectos sin grupo propio, y ventana de horario laboral
  // (horas en punto, 0-23) fuera de la cual las alertas se encolan en
  // WhatsAppQueueItem en vez de mandarse al toque.
  whatsappGroupJid String?
  workHoursStart   Int     @default(8)
  workHoursEnd     Int     @default(18)
  // Hora local exacta para el único resumen individual diario.
  // Debe permanecer dentro de [workHoursStart, workHoursEnd).
  dailyDigestHour  Int     @default(8)
  dailyDigestMinute Int    @default(0)

  // Chontatec (bot asistente in-app, ver src/lib/botSettings.ts y
  // src/lib/chontatec.ts). La API key vive acá (DB) en vez de env porque
  // se decidió explícitamente que se configure desde la UI sin redeploy y
  // sin tener que ser la misma cuenta de Anthropic que usa el resto de la
  // infraestructura (confirmado con el usuario).
  // ponytail: queda en texto plano, igual que el resto de esta fila — no
  // hay cifrado de secretos en ningún otro lado de la app (AUTH_SECRET,
  // etc. viven sin cifrar en .env). Si algún día esta DB se trata como
  // "no confiable" (backups compartidos, hosting multi-tenant), agregar
  // cifrado simétrico con una clave maestra nueva por env var recién ahí.
  botName                    String    @default("Chontatec")
  botAvatarUrl               String?
  botApiKey                  String?
  // Tono/personalidad editable desde Configuración (ver DEFAULT_BOT_PERSONA
  // en src/lib/botSettings.ts) — null significa "usar el default de fábrica".
  // Las reglas operativas no negociables (usar las tools, nunca inventar
  // datos) NO viven acá, están fijas en src/lib/chontatec.ts.
  botPersonaPrompt           String?   @db.Text
  // Mensaje de presentación que el bot manda (con foto de perfil) la
  // primera vez que le escribe por WhatsApp a alguien — null usa el default
  // de fábrica (ver DEFAULT_BOT_INTRO_MESSAGE en botSettings.ts). Editable
  // porque este mismo software puede correr para otra empresa con otro
  // nombre/funciones que describir acá.
  botIntroMessage            String?   @db.Text
  botMonthlyQuestionLimit    Int       @default(300)
  botQuestionsUsedThisPeriod Int       @default(0)
  botUsagePeriodStart        DateTime?
}

// Historial de chat con Chontatec (ver src/lib/chontatec.ts). Log plano
// por usuario — no hay "conversaciones"/threads con título, es un Q&A
// continuo. `content` guarda el array de content blocks de Anthropic tal
// cual (texto, tool_use, tool_result) para poder reconstruir
// messages.create() sin transformación.
model BotMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String   @db.LongText // JSON.stringify(content blocks[])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Cola de alertas de WhatsApp generadas fuera de horario laboral — el
// poller de scheduler.ts las despacha apenas vuelve a abrir el horario.
// `target` ya viene resuelto (JID de grupo o de persona) para no repetir
// la lógica de destino al momento de despachar.
model WhatsAppQueueItem {
  id        String    @id @default(cuid())
  target    String
  message   String    @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}

// Punto 2.6.1: Configuración > "Pruebas" — plantillas reutilizables de
// checks para no escribir/enumerar cada prueba a mano en cada revisión.
model TestTemplate {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  items                  TestTemplateItem[]
  tasksWithThisAsDefault Task[]
}

// title = nombre corto del check (ej. "Prueba de responsividad"); criteria =
// puntos específicos y verificables debajo del título, uno por línea (ej.
// "No se sale de la vista en móvil"). criteria es libre/opcional porque no
// todo check necesita desglose.
model TestTemplateItem {
  id         String       @id @default(cuid())
  templateId String
  template   TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String       @map("description")
  criteria   String?      @db.Text
  category   String?
  order      Int
}

// Plantilla de respuestas para quien corrige — categorías + respuestas
// predefinidas, para no escribir la misma corrección de memoria cada vez.
model ResponseCategory {
  id   String @id @default(cuid())
  name String

  responses ResponseTemplate[]
}

model ResponseTemplate {
  id         String           @id @default(cuid())
  categoryId String
  category   ResponseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  text       String
}

// Una ronda de revisión = un envío a revisar + sus checks + su resultado.
// roundNumber sube en cada reintento tras una devolución (punto 2.6, flujo
// Aprobada/Con hallazgos/Con errores -> Devuelta -> nueva ronda).
model ReviewRound {
  id            String         @id @default(cuid())
  taskId        String
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  roundNumber   Int
  submittedById String
  submittedBy   User           @relation("ReviewRoundSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime       @default(now())
  outcome       ReviewOutcome?
  closedAt      DateTime?

  deliverables ReviewDeliverable[]
  checks       ReviewCheck[]
  messages     ReviewMessage[]
}

// Lo que el responsable entrega para que se revise (link o archivo).
model ReviewDeliverable {
  id            String      @id @default(cuid())
  reviewRoundId String
  reviewRound   ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  fileUrl       String
  fileName      String
  mimeType      String
  uploadedAt    DateTime    @default(now())
}

// Instancia editable de un ítem de plantilla (o agregado ad-hoc) dentro de
// UNA ronda — quitar/editar acá nunca toca TestTemplateItem.
model ReviewCheck {
  id                   String       @id @default(cuid())
  reviewRoundId        String
  reviewRound          ReviewRound  @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  title                String       @map("description")
  criteria             String?      @db.Text
  category             String?
  result               CheckResult?
  note                 String?      @db.Text
  responseCategory     String?      @db.Text
  reviewedById         String?
  reviewedBy           User?        @relation("ReviewCheckReviewer", fields: [reviewedById], references: [id])
  // Tarea tipo ACCEPTANCE: quien califica es el cliente sin cuenta desde el
  // link compartido, no un User — se identifica por nombre (obligatorio) y
  // rol (opcional), mismo patrón que ShareComment.authorName/authorRole.
  // Queda null para un check de tarea QA (lo calificó reviewedById).
  externalReviewerName String?
  externalReviewerRole String?
  order                Int
  // Puntos 8/13: id del TestTemplateItem del que nació este check (null si
  // se agregó a mano). Sin relación formal a propósito (el template puede
  // cambiar/borrarse sin que esto deba romperse) — solo sirve para que
  // copyTemplateItemsToRound sea idempotente: reaplicar la plantilla nunca
  // duplica un punto que ya está en la ronda, así que "aplicar plantilla" de
  // nuevo es también la forma de recuperar uno que se había quitado.
  sourceTemplateItemId String?

  evidence ReviewCheckEvidence[]
}

model ReviewCheckEvidence {
  id            String      @id @default(cuid())
  reviewCheckId String
  reviewCheck   ReviewCheck @relation(fields: [reviewCheckId], references: [id], onDelete: Cascade)
  fileUrl       String
  fileName      String
  mimeType      String
  uploadedAt    DateTime    @default(now())
}

// Chat de devolución — editable, no borrable, sin menciones (decisión ya
// confirmada con el usuario).
model ReviewMessage {
  id            String      @id @default(cuid())
  reviewRoundId String
  reviewRound   ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String      @db.Text
  editedAt      DateTime?
  createdAt     DateTime    @default(now())
}

// Punto 17 confirmado con el usuario: sistema de etiquetas por categoría
// para seguir un mismo elemento/objetivo a través de varias tareas (ej.
// categoría "Componentes", etiqueta "hero-banner" repetida en la tarea de
// maquetación y en la de codificación). La CATEGORÍA es global (color de la
// misma paleta que ya usan los proyectos + emoji opcional, se crea en
// Configuración) — el NOMBRE de la etiqueta se crea al vuelo la primera vez
// que se usa y queda guardado, pero solo dentro de ESE proyecto.
model TagCategory {
  id        String   @id @default(cuid())
  name      String
  colorHex  String
  emoji     String?
  createdAt DateTime @default(now())

  tags Tag[]
}

model Tag {
  id         String      @id @default(cuid())
  categoryId String
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime    @default(now())

  taskTags TaskTag[]

  // El mismo nombre puede repetirse en categorías o proyectos distintos,
  // pero no dos veces bajo la misma categoría en el mismo proyecto.
  @@unique([projectId, categoryId, name])
}

// categoryId queda denormalizado acá (ya vive en Tag) a propósito: es lo que
// permite la restricción "una sola etiqueta por categoría por tarea"
// (confirmada con el usuario) como un @@unique de una sola tabla, sin tener
// que validarla a mano en cada acción.
model TaskTag {
  id         String @id @default(cuid())
  taskId     String
  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([taskId, categoryId])
}
