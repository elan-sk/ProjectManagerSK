# Base de datos MySQL (la incluida en el plan de hosting de Hostinger) —
# mismo proveedor en desarrollo y producción, ver prisma/schema.prisma.
# Formato: mysql://usuario:contraseña@host:puerto/basededatos
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/projectmanagersk"

# Auth.js — generar con: npx auth secret
AUTH_SECRET=""

# Web Push (VAPID) — generar con: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Google Calendar (opcional) — Google Cloud Console > APIs & Services > Credentials
# 1. Crear un "OAuth client ID" tipo "Web application"
# 2. Habilitar la Google Calendar API para el proyecto
# 3. Authorized redirect URI: <NEXTAUTH_URL>/api/google-calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL pública de la app (usada para armar el redirect_uri de Google)
NEXTAUTH_URL="http://localhost:3000"

# Alertas por WhatsApp (Baileys, sesión personal vía WhatsApp Web — no es la
# API oficial de Meta, ver AGENTS.md). Poner en "true" solo cuando se vaya a
# usar: al arrancar el server pide escanear un QR desde tu teléfono. El grupo
# de alertas (por defecto y por proyecto) se elige desde Configuración, no acá.
WHATSAPP_ENABLED="false"

# Solo en Hostinger (dejar vacío en local): carpeta ABSOLUTA fuera de
# hbuilds/versions/ donde deben vivir los archivos subidos (íconos de
# proyecto, adjuntos, avatares) para que sobrevivan al próximo deploy — cada
# deploy activa una carpeta de versión nueva sin heredar nada de la anterior,
# así que public/uploads/ se pierde entero si no apunta acá. Ver
# ensurePersistentUploads en src/lib/persistentUploads.ts y la guía de deploy.
PERSISTENT_UPLOADS_DIR=""

# Modo prueba de WhatsApp (solo desarrollo): si se define, únicamente ese número recibe mensajes; el resto y los grupos se descartan.
# WHATSAPP_ONLY_PHONE="57XXXXXXXXXX"
